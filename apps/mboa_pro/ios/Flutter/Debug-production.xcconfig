// Flavour configuration — one per (build type, environment).
// Mirrors Debug/Release.xcconfig: CocoaPods names its file after
// the configuration, not the build type, so Profile-dev takes
// Pods-Runner.profile-dev and not the release one.
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug-production.xcconfig"
#include "Generated.xcconfig"
