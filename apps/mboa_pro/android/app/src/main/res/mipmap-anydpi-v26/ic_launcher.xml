<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). Without it a launcher frames the logo in a white
     circle of its own; with it the forest green is the icon's own shape, and
     the monogram sits inside the 66% safe zone so no mask clips a gable. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
